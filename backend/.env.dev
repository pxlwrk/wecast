APP_NAME=WeCast
APP_ENV=development
APP_BASE_URL=http://localhost:8000
SECRET_KEY=dev-secret-key-not-for-production-32chars
DEBUG=true

DATABASE_URL=postgresql+asyncpg://wecast:wecast_dev@localhost:5432/wecast

REDIS_URL=redis://localhost:6379/0

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=wecast_admin
MINIO_SECRET_KEY=wecast_dev_secret
MINIO_SECURE=false
MINIO_BUCKET_MEDIA=wecast-media
MINIO_BUCKET_HLS=wecast-hls
MINIO_BUCKET_RECORDINGS=wecast-recordings

LDAP_ENABLED=false

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

OLLAMA_ENABLED=false

WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=de

LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_PASSWORD=admin123

AUDIT_LOG_ENABLED=true
IP_HASH_SALT=dev-salt-changeme

CORS_ORIGINS=http://localhost:3000,http://localhost:8000
