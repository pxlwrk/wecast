# ─── Application ────────────────────────────────────────────────────────────
APP_NAME=WeCast
APP_ENV=production
APP_BASE_URL=https://wecast.company.com
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_-hex_32
DEBUG=false

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://wecast:CHANGE_ME@localhost:5432/wecast

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── MinIO / Object Storage ──────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_SECURE=false
MINIO_BUCKET_MEDIA=wecast-media
MINIO_BUCKET_HLS=wecast-hls
MINIO_BUCKET_RECORDINGS=wecast-recordings

# ─── LDAP / Active Directory ─────────────────────────────────────────────────
LDAP_ENABLED=true
LDAP_URL=ldaps://ad.company.com:636
LDAP_BIND_DN=cn=wecast-svc,ou=ServiceAccounts,dc=company,dc=com
LDAP_BIND_PASSWORD=CHANGE_ME
LDAP_BASE_DN=dc=company,dc=com
LDAP_USER_FILTER=(sAMAccountName={username})
LDAP_GROUP_ATTR=memberOf
# AD Group DN → Role Mapping (comma-separated list of dn:role pairs)
LDAP_ADMIN_GROUP_DN=CN=WeCast-Admins,OU=Groups,DC=company,DC=com
LDAP_MODERATOR_GROUP_DN=CN=WeCast-Moderators,OU=Groups,DC=company,DC=com
# All authenticated users get User role by default (no group required)
LDAP_TLS_VALIDATE=true
LDAP_TLS_CA_CERTS_FILE=/etc/ssl/certs/company-ca.pem

# ─── JWT Tokens ──────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Ollama ──────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_ENABLED=true

# ─── Whisper / Transcription ─────────────────────────────────────────────────
WHISPER_MODEL=medium
# Options: tiny, base, small, medium, large-v3
WHISPER_DEVICE=cpu
# Options: cpu, cuda (requires NVIDIA GPU)
WHISPER_COMPUTE_TYPE=int8
# Options: int8, float16, float32
WHISPER_LANGUAGE=de
# Default language (ISO 639-1), leave empty for auto-detect

# ─── Local Admin (Fallback when LDAP unavailable) ────────────────────────────
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_PASSWORD=CHANGE_ME_on_first_run

# ─── Audit & Privacy ─────────────────────────────────────────────────────────
AUDIT_LOG_ENABLED=true
IP_HASH_SALT=CHANGE_ME_generate_with_openssl_rand_-hex_16

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=https://wecast.company.com,https://intranet.company.com
